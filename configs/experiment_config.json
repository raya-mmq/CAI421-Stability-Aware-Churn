{
  "_comment": "CAI 421 shared reproducibility settings. Values for the data pipeline and MLP are COPIED from preprocess.py / train_mlp.py for documentation only; those scripts remain the source of truth and do not read this file. train_logistic_regression.py reads the 'logistic_regression' and 'data_integrity' blocks.",

  "dataset": {
    "name": "IBM Telco Customer Churn",
    "file": "data/raw/Telco-Customer-Churn.csv",
    "source_repository": "https://github.com/IBM/telco-customer-churn-on-icp4d",
    "source_path_in_repository": "data/Telco-Customer-Churn.csv",
    "sha256": "16320c9c1ec72448db59aa0a26a0b95401046bef5d02fd3aeb906448e3055e91",
    "n_records": 7043,
    "redistributed_in_this_repository": false
  },

  "shared_pipeline": {
    "script": "preprocess.py",
    "owner": "Student 3",
    "seed": 42,
    "split": "stratified 70/15/15 (train_test_split twice, stratify=y, random_state=42)",
    "n_train": 4930,
    "n_val": 1056,
    "n_test": 1057,
    "n_features": 45,
    "feature_order_file": "data/processed/feature_names.json",
    "numeric_scaled": ["tenure", "MonthlyCharges", "TotalCharges"],
    "binary_kept": ["SeniorCitizen"],
    "categorical_one_hot": 15,
    "totalcharges_rule": "11 blank values (all tenure = 0) set to 0",
    "fitted_on": "training split only"
  },

  "mlp_reference": {
    "script": "train_mlp.py",
    "owner": "Student 5",
    "framework": "NumPy (explicit forward/backward pass)",
    "architecture": [45, 32, 1],
    "activations": ["ReLU", "Sigmoid"],
    "optimizer": "Adam (lr 0.003, beta1 0.9, beta2 0.999, eps 1e-8)",
    "batch_size": 128,
    "weight_decay": 0.0001,
    "max_epochs": 300,
    "early_stopping_patience": 20,
    "selection_metric": "validation ROC-AUC over a 24-config grid",
    "reported_seed": 42,
    "robustness_seeds": [42, 43, 44, 45, 46],
    "threshold": 0.5
  },

  "logistic_regression": {
    "owner": "Student 4",
    "seed": 42,
    "threshold": 0.5,
    "fit_on": "train",
    "selection_split": "val",
    "selection_metric": "roc_auc",
    "selection_rule": "highest validation ROC-AUC; ties broken by the smaller C (stronger regularisation)",
    "regularisation": "L2 (scikit-learn default; penalty= is deprecated from 1.8 and therefore not passed)",
    "fixed_params": {
      "solver": "lbfgs",
      "max_iter": 10000,
      "tol": 0.0001,
      "fit_intercept": true,
      "class_weight": null,
      "random_state": 42
    },
    "grid": {
      "C": [0.001, 0.01, 0.1, 1.0, 10.0, 100.0]
    },
    "pr_auc_definition": "sklearn.metrics.average_precision_score (step-wise average precision), the same convention as train_mlp.py",
    "bootstrap": {
      "n_resamples": 2000,
      "seed": 42,
      "type": "paired, stratified by class, on the fixed test set"
    }
  },

  "data_integrity": {
    "_comment": "SHA-256 of the processed files produced by preprocess.py from the reference CSV (verified on 2026-10-30 with scikit-learn 1.9.1 / pandas 3.0.5; byte-identical to the files shipped by Students 3 and 5).",
